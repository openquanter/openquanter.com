---
import Base from "../layouts/Base.astro";
import { en } from "../i18n/en";
---

<Base t={en} path="/404">
  <section class="hero">
    <div class="wrap">
      <span class="kicker">404</span>
      <h1 class="h2">This page does not reconcile.</h1>
      <p class="lede">Nothing is recorded at this address. 此地址没有记录。</p>
      <div class="cta">
        <a class="btn btn-ink" href="/">openquanter.com</a>
        <a class="btn btn-ghost" href="/zh/">中文</a>
      </div>
    </div>
  </section>
</Base>
