---
import Base from "../layouts/Base.astro";
import { en } from "../i18n/en";
---

<Base t={en} path="/404">
  <section class="hero">
    <div class="wrap hero-copy" style="padding-bottom:96px">
      <span class="kicker">404</span>
      <h1>This page does not <span>reconcile.</span></h1>
      <p class="hero-sub">Nothing is recorded at this address. 此地址没有记录。</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/">openquanter.com</a>
        <a class="btn btn-secondary" href="/zh/">中文</a>
      </div>
    </div>
  </section>
</Base>
