---
// Lucide icons (ISC), inlined at build time so the page ships no icon JS.
import * as lucide from "lucide-static";

interface Props {
  name: keyof typeof lucide;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = "" } = Astro.props;
const raw = (lucide[name] as unknown as string) ?? "";
const svg = raw
  .replace(/width="\d+"/, `width="${size}"`)
  .replace(/height="\d+"/, `height="${size}"`)
  .replace(/stroke-width="[\d.]+"/, 'stroke-width="1.8"')
  .replace(/class="[^"]*"/, `class="icon ${cls}" aria-hidden="true"`);
---

<Fragment set:html={svg} />
